# ==========================================================================
# .gitignore - Tari's Firma Digital
# Principio III de la constitución: el repositorio NO debe contener secretos,
# certificados, claves ni documentos de clientes.
# Las clases [xX] evitan depender de mayúsculas en Linux/macOS.
# ==========================================================================

# Certificados de firma electrónica y claves privadas
*.[pP]12
*.[pP][fF][xX]
*.[kK][eE][yY]
*.[pP][eE][mM]
*.[cC][rR][tT]
*.[cC][eE][rR]

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Documentos de clientes (cédulas, selfies, certificados de RUC).
# Si necesitas guardarlos localmente, usa solo esta carpeta.
documentos-clientes/

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Editores
.vscode/
.idea/
*.swp

# Configuración local de Claude Code
.claude/settings.local.json

# Dependencias de desarrollo (por si se añaden en el futuro)
node_modules/
